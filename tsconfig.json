{
  "compilerOptions": {
    "target": "ES2022",
    "types": ["node", "@playwright/test"],
    "module": "nodenext",  
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts", "scripts/setup-session.js"],
  "exclude": ["node_modules"]
}